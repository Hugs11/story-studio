diff --git a/libpiper/tests/test_wavfile.cpp b/libpiper/tests/test_wavfile.cpp
index 5039a89..a7d41b5 100644
--- a/libpiper/tests/test_wavfile.cpp
+++ b/libpiper/tests/test_wavfile.cpp
@@ -1,0 +2,2 @@
+#include <cmath>
+#include <cstring>
@@ -3,0 +6 @@
+#include <vector>
@@ -30,0 +34,21 @@ piper_synthesizer *WavFileTest::synth = nullptr;
+TEST(WavFileUtilsTest, NormalizesFiniteSamples) {
+  std::vector<float> samples{-0.25F, 0.5F, 0.125F};
+  normalizeAudioSamples(samples);
+  EXPECT_FLOAT_EQ(samples[0], -0.5F);
+  EXPECT_FLOAT_EQ(samples[1], 1.0F);
+  EXPECT_FLOAT_EQ(samples[2], 0.25F);
+}
+
+TEST(WavFileUtilsTest, QuasiSilenceBecomesSilence) {
+  std::vector<float> samples{0.0F, -1e-9F, 1e-9F};
+  normalizeAudioSamples(samples);
+  EXPECT_EQ(samples, std::vector<float>(3, 0.0F));
+}
+
+TEST(WavFileUtilsTest, NonFiniteSamplesBecomeSilence) {
+  std::vector<float> samples{0.5F, std::nanf(""), -0.25F};
+  normalizeAudioSamples(samples);
+  EXPECT_EQ(samples[1], 0.0F);
+  EXPECT_FLOAT_EQ(samples[0], 1.0F);
+}
+
