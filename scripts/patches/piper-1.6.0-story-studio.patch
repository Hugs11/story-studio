diff --git a/libpiper/src/main/utils/wavfile.cpp b/libpiper/src/main/utils/wavfile.cpp
index fbaed5c..ab19b9b 100644
--- a/libpiper/src/main/utils/wavfile.cpp
+++ b/libpiper/src/main/utils/wavfile.cpp
@@ -2,0 +3,2 @@
+#include <algorithm>
+#include <cmath>
@@ -4,0 +7,20 @@
+void normalizeAudioSamples(std::vector<float> &samples) {
+    float maxAmplitude = 0.0F;
+    for (const float sample : samples) {
+        if (std::isfinite(sample)) {
+            maxAmplitude = std::max(maxAmplitude, std::abs(sample));
+        }
+    }
+
+    if (maxAmplitude < 1e-8F) {
+        std::fill(samples.begin(), samples.end(), 0.0F);
+        return;
+    }
+
+    for (float &sample : samples) {
+        sample = std::isfinite(sample)
+                     ? std::clamp(sample / maxAmplitude, -1.0F, 1.0F)
+                     : 0.0F;
+    }
+}
+
@@ -13 +35,2 @@ void textToWavFile(piper_synthesizer *piper,
-    bool isHeaderWritten = false;
+    std::vector<float> samples;
+    int sampleRate = 0;
@@ -17,6 +40,4 @@ void textToWavFile(piper_synthesizer *piper,
-            if (!isHeaderWritten) {
-                writeWavStreamHeader(stream, chunk.sample_rate);
-                isHeaderWritten = true;
-            }
-            stream.write(reinterpret_cast<const char *>(chunk.samples),
-                       chunk.num_samples * sizeof(float));
+            sampleRate = chunk.sample_rate;
+            samples.insert(samples.end(),
+                           chunk.samples,
+                           chunk.samples + chunk.num_samples);
@@ -24,0 +46,7 @@ void textToWavFile(piper_synthesizer *piper,
+
+    if (!samples.empty()) {
+        normalizeAudioSamples(samples);
+        writeWavStreamHeader(stream, sampleRate);
+        stream.write(reinterpret_cast<const char *>(samples.data()),
+                     samples.size() * sizeof(float));
+    }
