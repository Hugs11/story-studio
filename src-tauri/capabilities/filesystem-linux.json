{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "filesystem-linux",
  "description": "User-selected file access with Linux system locations denied",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }],
      "deny": [
        { "path": "/boot" },
        { "path": "/boot/**" },
        { "path": "/dev" },
        { "path": "/dev/**" },
        { "path": "/etc" },
        { "path": "/etc/**" },
        { "path": "/proc" },
        { "path": "/proc/**" },
        { "path": "/root" },
        { "path": "/root/**" },
        { "path": "/run" },
        { "path": "/run/dbus/**" },
        { "path": "/run/systemd/**" },
        { "path": "/run/udev/**" },
        { "path": "/sys" },
        { "path": "/sys/**" },
        { "path": "/usr" },
        { "path": "/usr/**" },
        { "path": "/bin" },
        { "path": "/bin/**" },
        { "path": "/sbin" },
        { "path": "/sbin/**" },
        { "path": "/lib" },
        { "path": "/lib/**" },
        { "path": "/lib64" },
        { "path": "/lib64/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "**" },
        { "path": "**/.session-recovery.mbah*" },
        { "path": "**/.story-studio-backups" },
        { "path": "**/.story-studio-backups/**" },
        { "path": "**/.story-studio-image-edits" },
        { "path": "**/.story-studio-image-edits/**" },
        { "path": "**/.story-studio-thumbnail" },
        { "path": "**/.story-studio-thumbnail/**" }
      ],
      "deny": [
        { "path": "/boot" },
        { "path": "/boot/**" },
        { "path": "/dev" },
        { "path": "/dev/**" },
        { "path": "/etc" },
        { "path": "/etc/**" },
        { "path": "/proc" },
        { "path": "/proc/**" },
        { "path": "/root" },
        { "path": "/root/**" },
        { "path": "/run" },
        { "path": "/run/dbus/**" },
        { "path": "/run/systemd/**" },
        { "path": "/run/udev/**" },
        { "path": "/sys" },
        { "path": "/sys/**" },
        { "path": "/usr" },
        { "path": "/usr/**" },
        { "path": "/bin" },
        { "path": "/bin/**" },
        { "path": "/sbin" },
        { "path": "/sbin/**" },
        { "path": "/lib" },
        { "path": "/lib/**" },
        { "path": "/lib64" },
        { "path": "/lib64/**" }
      ]
    }
  ]
}
