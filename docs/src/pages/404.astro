---
import '../styles/landing.css';

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0c1227" />
    <title>Page introuvable — Story Studio</title>
    <link rel="icon" type="image/svg+xml" href={`${base}logostory.svg`} />
  </head>
  <body>
    <main class="error-page" data-pagefind-ignore>
      <div class="container">
        <img class="error-page__logo" src={`${base}logostory.svg`} alt="Story Studio" />
        <p class="error-page__code">Erreur 404</p>
        <h1>Page introuvable</h1>
        <p>Cette adresse ne correspond à aucune page du site Story Studio.</p>
        <a class="btn" href={`${base}docs/`}>Revenir à la documentation</a>
      </div>
    </main>
  </body>
</html>
