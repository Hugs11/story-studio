---
import '../styles/landing.css';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Story Studio pour Lunii — Créer, éditer et tester des packs</title>
    <meta
      name="description"
      content="Story Studio est un éditeur desktop open source pour Windows, Linux et macOS permettant de créer, importer, corriger et exporter des packs d'histoires compatibles Lunii."
    />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="EW_r5pSDajA6Py5Z_duzkWnG2z-j_8UgUwk07VyOa4c" />
    <meta name="theme-color" content="#0c1227" />
    <link rel="canonical" href="https://hugs11.github.io/story-studio/" />
    <link rel="author" href="https://hugs11.github.io/" />

    <meta property="og:title" content="Story Studio pour Lunii — Créer et tester des packs" />
    <meta
      property="og:description"
      content="Éditeur desktop open source pour Windows, Linux et macOS permettant de créer, importer, corriger et exporter des packs compatibles Lunii."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Story Studio" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content="https://hugs11.github.io/story-studio/" />
    <meta property="og:image" content="https://hugs11.github.io/story-studio/social-card.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Story Studio — éditeur de packs d'histoires pour la Lunii" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Story Studio pour Lunii — Créer et tester des packs" />
    <meta name="twitter:description" content="Éditeur desktop open source pour Windows, Linux et macOS permettant de créer, importer, corriger et exporter des packs compatibles Lunii." />
    <meta name="twitter:image" content="https://hugs11.github.io/story-studio/social-card.png" />
    <meta name="twitter:image:alt" content="Story Studio — éditeur de packs d'histoires pour la Lunii" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Story Studio",
        "alternateName": "Story Studio pour Lunii",
        "description": "Éditeur desktop open source pour Windows, Linux et macOS permettant de créer, importer, corriger et exporter des packs d'histoires compatibles Lunii.",
        "url": "https://hugs11.github.io/story-studio/",
        "downloadUrl": "https://github.com/Hugs11/story-studio/releases/latest",
        "codeRepository": "https://github.com/Hugs11/story-studio",
        "applicationCategory": "MultimediaApplication",
        "operatingSystem": "Windows 10+, Linux x86_64, macOS 11+",
        "softwareVersion": "0.9.8",
        "license": "https://github.com/Hugs11/story-studio/blob/main/LICENSE",
        "author": {
          "@type": "Person",
          "name": "Hugs11",
          "url": "https://github.com/Hugs11"
        },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR"
        }
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="logostory.svg" />

  </head>
  <body>
    <header class="site">
      <div class="container">
        <img class="logo" src="logostory.svg" alt="Story Studio" />
        <div class="badge" id="version-badge" aria-live="polite">
          <span class="dot"></span>
          <span id="version-text">Chargement de la dernière version…</span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <h1>Créer des histoires pour la Lunii avec Story Studio</h1>
          <p class="tagline">
            Story Studio est un éditeur desktop open source pour Windows,
            Linux et macOS. Il permet de créer des histoires pour la Lunii,
            importer, corriger, organiser, tester et exporter des packs
            compatibles Lunii dans une interface visuelle.
          </p>
          <p class="tagline">
            Si vous cherchez un outil pour créer des histoires pour la Lunii,
            Story Studio est fait pour vous. Le projet reste local, gratuit et
            pensé pour créer facilement et visuellement vos histoires audio.
          </p>

          <div class="cta-group">
            <a
              id="download-btn"
              class="btn"
              href="https://github.com/Hugs11/story-studio/releases/latest"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span id="download-label">Voir les téléchargements</span>
            </a>
            <div class="cta-meta" id="download-meta">
              Windows x64 · Linux x86_64 · macOS Apple Silicon
            </div>
            <div class="hero-links">
              <a href="docs/">Documentation</a>
              <a href="https://github.com/Hugs11/story-studio/releases/latest">Notes de version</a>
              <a href="https://github.com/Hugs11/story-studio/blob/main/CHANGELOG.md">Changelog complet</a>
              <a href="https://github.com/Hugs11/story-studio">Code source</a>
            </div>
          </div>

          <div class="release-card" aria-labelledby="latest-release-title">
            <h2 id="latest-release-title">Nouveautés de la version 0.9.8</h2>
            <ul>
              <li>Documentation utilisateur complète, structurée et recherchable directement en ligne.</li>
              <li>Navigation plus fidèle dans les Dossiers, le simulateur et les fins personnalisées.</li>
              <li>Choix de la langue audio YouTube et reprise des sessions temporaires plus fiables.</li>
            </ul>
          </div>

          <div class="demo-card" aria-labelledby="demo-packs-title">
            <h2 id="demo-packs-title">Deux packs pour découvrir Story Studio</h2>
            <p>
              Ouvrez-les dans le simulateur, explorez leur structure puis adaptez-les
              librement dans l'éditeur.
            </p>
            <div class="demo-links">
              <a class="demo-link" href="https://drive.proton.me/urls/5ND49D487R#IxRa3Bd0Lm8L" target="_blank" rel="noopener noreferrer">
                <img class="demo-cover" src="assets/demo-packs/leo-la-licorne.png" alt="Couverture de Léo la licorne" />
                <span class="demo-link-copy">
                  <span>Léo la licorne</span>
                  <span class="demo-link-source">Télécharger sur Proton Drive ↗</span>
                </span>
              </a>
              <a class="demo-link" href="https://drive.proton.me/urls/H7ZTBC8S14#aj2WBn39jDRF" target="_blank" rel="noopener noreferrer">
                <img class="demo-cover" src="assets/demo-packs/toudou-cache-cache.png" alt="Couverture de Toudou mon doudou et Cache-Cache" />
                <span class="demo-link-copy">
                  <span>Toudou mon doudou + Cache-Cache</span>
                  <span class="demo-link-source">Télécharger sur Proton Drive ↗</span>
                </span>
              </a>
            </div>
            <ol class="demo-steps">
              <li>Téléchargez le fichier ZIP du pack depuis Proton Drive.</li>
              <li>Lancez Story Studio et cliquez sur <strong>Modifier un pack existant</strong>.</li>
              <li>Sélectionnez le fichier <code>.zip</code> téléchargé.</li>
            </ol>
            <p class="demo-note">
              Ces packs sont distribués séparément du logiciel et leurs contenus ne
              sont pas couverts par la licence MIT de Story Studio.
            </p>
          </div>
        </div>
        <div class="hero-shot">
          <img
            src="assets/screenshots/workspace-dark.png"
            alt="Espace de travail unifié de Story Studio"
            width="1080"
          />
        </div>
      </section>

      <section id="features">
        <div class="container">
          <h2>Du premier import au pack prêt à jouer</h2>
          <p class="journey-intro">
            Story Studio rassemble tout le parcours dans une application locale :
            partir de ses propres fichiers ou d'un pack existant, préparer les
            médias, construire la navigation, tester le résultat et exporter un
            pack prêt pour la boîte à histoires.
          </p>

          <div class="journey">
            <article class="journey-step">
              <div class="journey-copy">
                <span class="journey-number">1</span>
                <h3>Démarrer un projet ou importer des histoires</h3>
                <p>
                  Créez selon vos envies, reprenez un travail enregistré,
                  modifiez un pack ZIP/7z existant ou partez d'un podcast ou de
                  YouTube. Des parcours guidés permettent aussi d'agréger
                  plusieurs packs ou d'analyser un pack communautaire.
                </p>
              </div>
              <figure class="journey-media">
                <img
                  src="assets/screenshots/home-dark.png"
                  alt="Accueil guidé de Story Studio avec les différents parcours de création et d'import"
                  loading="lazy"
                />
              </figure>
            </article>

            <article class="journey-step">
              <div class="journey-copy">
                <span class="journey-number">2</span>
                <h3>Préparer les fichiers audio</h3>
                <p>
                  Importez ou enregistrez un son, puis ajustez-le avant de
                  l'utiliser dans une histoire. Un enregistrement long peut être
                  découpé en extraits réutilisables ; plusieurs fichiers peuvent
                  aussi être réordonnés et assemblés en une seule piste sans
                  modifier les originaux.
                </p>
              </div>
              <figure class="journey-media">
                <img
                  src="assets/screenshots/audio-editor-dark.png"
                  alt="Éditeur audio de Story Studio"
                  loading="lazy"
                />
              </figure>
              <div class="media-pair">
                <figure>
                  <img
                    src="assets/screenshots/Audio-decoupe-light.png"
                    alt="Découpe d'un enregistrement audio en plusieurs extraits"
                    loading="lazy"
                  />
                  <figcaption>Découper un enregistrement long</figcaption>
                </figure>
                <figure>
                  <img
                    src="assets/screenshots/Audio-assemble-light.png"
                    alt="Assemblage de plusieurs fichiers audio"
                    loading="lazy"
                  />
                  <figcaption>Réordonner et assembler plusieurs pistes</figcaption>
                </figure>
              </div>
            </article>

            <article class="journey-step">
              <div class="journey-copy">
                <span class="journey-number">3</span>
                <h3>Générer les voix et les images</h3>
                <p>
                  Piper fournit une synthèse vocale locale prête à l'emploi ;
                  XTTS peut être utilisé pour des voix personnalisées. Pour les
                  illustrations, Story Studio pilote les workflows ComfyUI
                  configurés dans l'application.
                </p>
              </div>
              <div class="media-pair">
                <figure>
                  <img
                    src="assets/screenshots/voice-generation-dark.png"
                    alt="Génération locale d'une voix avec Piper"
                    loading="lazy"
                  />
                  <figcaption>Générer une voix avec Piper ou XTTS</figcaption>
                </figure>
                <figure>
                  <img
                    src="assets/screenshots/comfyui-generation-dark.png"
                    alt="Génération d'une image avec un workflow ComfyUI"
                    loading="lazy"
                  />
                  <figcaption>Créer une illustration avec ComfyUI</figcaption>
                </figure>
              </div>
              <div class="journey-copy">
                <h3>Modifier et adapter les images</h3>
                <p>
                  Les images peuvent ensuite être recadrées, redimensionnées et
                  ajustées au format 320×240 de la boîte à histoires.
                </p>
              </div>
              <figure class="journey-media journey-media--compact">
                <img
                  src="assets/screenshots/image-editor-dark.png"
                  alt="Outils de recadrage et d'ajustement d'une image"
                  loading="lazy"
                />
              </figure>
            </article>

            <article class="journey-step">
              <div class="journey-copy">
                <span class="journey-number">4</span>
                <h3>Organiser, visualiser et tester le projet</h3>
                <p>
                  Construisez les menus et les histoires dans l'arbre, puis
                  réglez chaque nœud dans le panneau Réglages. Le diagramme donne
                  une vue d'ensemble de la structure, des retours et des
                  enchaînements du pack.
                </p>
              </div>
              <figure class="journey-media">
                <img
                  src="assets/screenshots/diagram-full-dark.png"
                  alt="Diagramme complet d'un pack complexe"
                  loading="lazy"
                />
              </figure>
              <div class="journey-copy">
                <p>
                  Le simulateur flottant permet de parcourir l'histoire comme
                  sur la boîte, tout en gardant le diagramme sous les yeux.
                </p>
              </div>
              <figure class="journey-media">
                <img
                  src="assets/screenshots/diagram-simulator-dark.png"
                  alt="Diagramme du pack avec le simulateur flottant"
                  loading="lazy"
                />
              </figure>
            </article>

            <article class="journey-step">
              <div class="journey-copy">
                <span class="journey-number">5</span>
                <h3>Vérifier les réglages puis générer le pack</h3>
                <p>
                  Contrôlez les métadonnées, la couverture et les options de
                  traitement audio avant l'export. Story Studio signale les
                  points à corriger et ne propose la génération que lorsque le
                  projet est prêt.
                </p>
              </div>
              <div class="media-pair media-pair--settings">
                <figure>
                  <img
                    src="assets/screenshots/pack-metadata-dark.png"
                    alt="Métadonnées et couverture du pack"
                    loading="lazy"
                  />
                  <figcaption>Renseigner les métadonnées du pack</figcaption>
                </figure>
                <figure>
                  <img
                    src="assets/screenshots/Pack-settings.png"
                    alt="Options de traitement audio et de lecture du pack"
                    loading="lazy"
                  />
                  <figcaption>Vérifier les options de génération</figcaption>
                </figure>
              </div>
              <div class="journey-copy">
                <p>
                  Le parcours de vérification peut aussi analyser un pack
                  communautaire existant : format, images, niveau sonore,
                  silences et navigation sont réunis dans un rapport lisible.
                </p>
              </div>
              <figure class="journey-media">
                <img
                  src="assets/screenshots/pack-checker-dark.png"
                  alt="Rapport de vérification d'un pack communautaire"
                  loading="lazy"
                />
              </figure>
            </article>
          </div>
        </div>
      </section>

      <section id="origin">
        <div class="container origin">
          <h2>Pourquoi Story Studio ?</h2>
          <p>
            Je cherchais un outil simple pour créer des histoires audio pour
            mon enfant. En tant qu'ancien monteur vidéo, je ne retrouvais pas
            dans les outils existants ce qui me semblait essentiel : une
            interface visuelle, directe et fluide, permettant de construire
            une narration sans friction, sans ligne de commande ni structures
            de dossiers complexes.
          </p>
          <p>
            Story Studio est né de ce besoin : rassembler l'import, les images,
            l'audio, la navigation, la simulation et l'export dans un même
            espace clair, local et compréhensible.
          </p>
        </div>
      </section>

      <section id="install">
        <div class="container">
          <h2>Comment installer</h2>
          <div class="steps">
            <div class="step">
              <h3>Choisissez votre plateforme</h3>
              <p>
                Le bouton en haut de la page propose le paquet recommandé pour votre
                système. La page GitHub Releases donne accès à tous les formats.
              </p>
            </div>
            <div class="step">
              <h3>Installez le paquet</h3>
              <p>
                Sous Windows, lancez l'EXE ou utilisez le MSI. Sous Linux,
                exécutez l'AppImage ou installez le DEB/RPM. Sur Mac Apple
                Silicon, ouvrez le DMG et glissez l'app dans Applications.
              </p>
            </div>
            <div class="step">
              <h3>Lancez Story Studio</h3>
              <p>
                Le build macOS n'est pas notarié : au premier lancement,
                faites un Contrôle-clic sur l'app puis choisissez
                <em>Ouvrir</em>, sans désactiver Gatekeeper globalement.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site">
      <div class="container">
        <div class="disclaimer">
          Story Studio est un outil communautaire gratuit et open source.
          <strong>Il n'est pas affilié, soutenu ou sponsorisé par Lunii.</strong>
        </div>
        <div class="links">
          <a href="docs/">Documentation</a>
          <a href="https://github.com/Hugs11/story-studio">Code source (GitHub)</a>
          <a href="https://github.com/Hugs11/story-studio/issues">Signaler un bug</a>
          <a href="https://github.com/Hugs11/story-studio/blob/main/CHANGELOG.md">Changelog</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var REPO = "Hugs11/story-studio";
        var API = "https://api.github.com/repos/" + REPO + "/releases/latest";
        var RELEASES_URL = "https://github.com/" + REPO + "/releases/latest";

        var btn = document.getElementById("download-btn");
        var label = document.getElementById("download-label");
        var meta = document.getElementById("download-meta");
        var versionText = document.getElementById("version-text");

        function formatSize(bytes) {
          if (!bytes && bytes !== 0) return "";
          var mb = bytes / (1024 * 1024);
          return mb >= 1 ? mb.toFixed(1) + " Mo" : (bytes / 1024).toFixed(0) + " Ko";
        }

        function detectPlatform() {
          var platform = (navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform || navigator.userAgent || "";
          if (/Mac/i.test(platform)) return "macos";
          if (/Linux|X11/i.test(platform)) return "linux";
          if (/Win/i.test(platform)) return "windows";
          return "other";
        }

        function platformDetails(platform) {
          if (platform === "macos") {
            return {
              label: "Télécharger pour macOS Apple Silicon",
              meta: "macOS 11 ou plus récent · DMG ARM64",
              pattern: /\.dmg$/i
            };
          }
          if (platform === "linux") {
            return {
              label: "Télécharger pour Linux",
              meta: "Linux x86_64 · AppImage",
              pattern: /\.AppImage$/i
            };
          }
          if (platform === "windows") {
            return {
              label: "Télécharger pour Windows",
              meta: "Windows 10 ou plus récent · EXE x64",
              pattern: /\.exe$/i
            };
          }
          return null;
        }

        function pickAsset(assets, details) {
          if (!assets || !assets.length) return null;
          if (!details) return null;
          return assets.find(function (asset) {
            return details.pattern.test(asset.name) && !/\.sig$/i.test(asset.name);
          });
        }

        function setFallback(message) {
          versionText.textContent = message || "Voir les versions disponibles";
          label.textContent = "Voir les téléchargements";
          btn.setAttribute("href", RELEASES_URL);
          meta.textContent = "Vous serez redirigé vers la page GitHub Releases.";
        }

        fetch(API, { headers: { Accept: "application/vnd.github+json" } })
          .then(function (res) {
            if (!res.ok) throw new Error("HTTP " + res.status);
            return res.json();
          })
          .then(function (release) {
            var version = (release.tag_name || release.name || "").replace(/^v/i, "");
            if (version) {
              versionText.textContent = "Version " + version + " — Bêta";
            } else {
              versionText.textContent = "Dernière version — Bêta";
            }

            var details = platformDetails(detectPlatform());
            var asset = pickAsset(release.assets || [], details);
            if (asset && asset.browser_download_url) {
              btn.setAttribute("href", asset.browser_download_url);
              label.textContent = details.label;
              var size = formatSize(asset.size);
              meta.textContent =
                details.meta + " · " +
                asset.name +
                (size ? " (" + size + ")" : "");
            } else {
              setFallback(version ? "Version " + version + " — Bêta" : null);
            }
          })
          .catch(function () {
            setFallback();
          });
      })();
    </script>
  </body>
</html>
