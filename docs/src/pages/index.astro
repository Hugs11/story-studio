---
import '../styles/landing.css';

---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Story Studio pour Lunii — Crée tes histoires et gère ta collection</title>
    <meta
      name="description"
      content="Crée tes histoires, range ta collection et envoie tes packs sur ta Lunii avec Story Studio 0.9.11. Application locale pour Windows, Linux et macOS, en français, anglais et italien."
    />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="EW_r5pSDajA6Py5Z_duzkWnG2z-j_8UgUwk07VyOa4c" />
    <meta name="theme-color" content="#0c1227" />
    <link rel="canonical" href="https://hugs11.github.io/story-studio/" />
    <link rel="author" href="https://hugs11.github.io/" />

    <meta property="og:title" content="Story Studio pour Lunii — Histoires, catalogue et transferts" />
    <meta
      property="og:description"
      content="Crée tes histoires, gère ta collection et connecte ta Lunii. Gratuit et open source, pour Windows, Linux et macOS, en français, anglais et italien."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Story Studio" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content="https://hugs11.github.io/story-studio/" />
    <meta property="og:image" content="https://hugs11.github.io/story-studio/social-card.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="Story Studio — éditeur de packs d'histoires pour la Lunii" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Story Studio pour Lunii — Histoires, catalogue et transferts" />
    <meta name="twitter:description" content="Crée tes histoires, gère ta collection et connecte ta Lunii. Application gratuite et open source pour Windows, Linux et macOS, en français, anglais et italien." />
    <meta name="twitter:image" content="https://hugs11.github.io/story-studio/social-card.png" />
    <meta name="twitter:image:alt" content="Story Studio — éditeur de packs d'histoires pour la Lunii" />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Story Studio",
        "alternateName": "Story Studio pour Lunii",
        "description": "Application desktop open source pour créer des histoires, organiser sa collection et transférer ses packs sur une Lunii, disponible en français, anglais et italien.",
        "url": "https://hugs11.github.io/story-studio/",
        "downloadUrl": "https://github.com/Hugs11/story-studio/releases/latest",
        "codeRepository": "https://github.com/Hugs11/story-studio",
        "applicationCategory": "MultimediaApplication",
        "inLanguage": ["fr", "en", "it"],
        "operatingSystem": "Windows 10+, Linux x86_64, macOS 11+",
        "softwareVersion": "0.9.11",
        "license": "https://github.com/Hugs11/story-studio/blob/main/LICENSE",
        "author": {
          "@type": "Person",
          "name": "Hugs11",
          "url": "https://github.com/Hugs11"
        },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR"
        }
      }
    </script>

    <link rel="icon" type="image/svg+xml" href="favicon.svg" />

  </head>
  <body>
    <header class="site">
      <div class="container">
        <img class="logo" src="logostory.svg" alt="Story Studio" />
        <div class="badge" id="version-badge" aria-live="polite">
          <span class="dot"></span>
          <span id="version-text">Story Studio 0.9.11</span>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <h1>Créer des histoires pour la Lunii avec Story Studio</h1>
          <p class="tagline">
            Story Studio est un logiciel pour créer et modifier des packs
            pour les boîtes à histoires Lunii. Il intègre des outils pour
            éditer le son et les images, et évite de devoir jongler avec
            Audacity ou d'autres logiciels pour créer ton pack d'histoires.
            Gratuit et open source, il est disponible sur Windows, Linux
            et macOS. Tout reste local : images, audio, navigation,
            simulation et génération du ZIP.
          </p>
          <p class="tagline">
            L'Éditeur par menus organise tes Dossiers et tes Histoires sous
            forme hiérarchique ; l'Éditeur graphe permet de créer des structures
            plus complexes, comme des quiz ou des histoires à choix multiples.
            L'Éditeur simplifié propose un parcours guidé.
          </p>
          <p class="tagline">
            Le catalogue rassemble tes packs, avec recherche, filtres, favoris et
            étiquettes. Branche ta Lunii pour consulter ses histoires,
            transférer tes packs, les rapatrier dans ta collection et
            éjecter l'appareil depuis Story Studio.
          </p>
          <p class="tagline">
            L'interface est disponible en français, anglais et italien.
            Les traductions anglaise et italienne sont produites puis vérifiées
            par IA. Tu peux proposer une correction sur GitHub :
            <a href="https://github.com/Hugs11/story-studio/blob/main/TRANSLATING.md">contribuer aux traductions</a>.
          </p>

          <div class="cta-group">
            <a
              id="download-btn"
              class="btn"
              href="https://github.com/Hugs11/story-studio/releases/latest"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span id="download-label">Voir les téléchargements</span>
            </a>
            <div class="cta-meta" id="download-meta">
              Windows x64 · Linux x86_64 · macOS Apple Silicon
            </div>
            <div class="hero-links">
              <a href="docs/">Documentation</a>
              <a href="https://discord.gg/jeC6Qk4NS" target="_blank" rel="noopener noreferrer">Discord</a>
              <a href="https://github.com/Hugs11/story-studio/releases/latest">Notes de version</a>
              <a href="https://github.com/Hugs11/story-studio/blob/main/CHANGELOG.md">Changelog complet</a>
              <a href="https://github.com/Hugs11/story-studio">Code source</a>
            </div>
          </div>

          <div class="release-card" aria-labelledby="latest-release-title">
            <h2 id="latest-release-title">Nouveautés de la version 0.9.11</h2>
            <ul>
              <li>Quand la Lunii est occupée, tes envois, rapatriements et retraits attendent leur tour. La liste montre ce qui reste à faire.</li>
              <li>Un son trop faible est signalé quand tu l’ajoutes. Si tu veux, Story Studio te prévient aussi quand une nouvelle version sort, sans rien installer tout seul.</li>
              <li>Beaucoup de corrections sur la Lunii, le catalogue et les éditeurs.</li>
            </ul>
          </div>

          <p><a href="docs/editeur-graphe/">Découvrir le guide de l'Éditeur graphe</a></p>

          <aside class="community-card" aria-labelledby="community-title">
            <div>
              <h2 id="community-title">Une idée, un retour ou besoin d'aide ?</h2>
              <p>
                Rejoins le Discord de Story Studio pour proposer une fonctionnalité,
                échanger autour d'un bug ou accéder aux versions bêta.
              </p>
            </div>
            <a href="https://discord.gg/jeC6Qk4NS" target="_blank" rel="noopener noreferrer">
              <svg class="discord-mark" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7.2 6.4A15.8 15.8 0 0 1 12 5.7c1.7 0 3.3.2 4.8.7 1.7 2.4 2.7 5.2 2.9 8.2-1.2 1.7-2.8 2.8-4.6 3.5l-1.1-1.5c.7-.3 1.3-.6 1.9-1.1-1.2.6-2.5.9-3.9.9s-2.7-.3-3.9-.9c.6.5 1.2.8 1.9 1.1l-1.1 1.5a10.6 10.6 0 0 1-4.6-3.5c.2-3 1.2-5.8 2.9-8.2Z" />
                <circle cx="9.2" cy="11.8" r="1.15" />
                <circle cx="14.8" cy="11.8" r="1.15" />
              </svg>
              Rejoindre le serveur Discord ↗
            </a>
          </aside>

          <div class="demo-card" aria-labelledby="demo-packs-title">
            <h2 id="demo-packs-title">Deux packs pour découvrir Story Studio</h2>
            <p>
              Ouvre-les dans le Simulateur, explore leur structure puis adapte-les
              comme tu veux dans l'éditeur.
            </p>
            <div class="demo-links">
              <a class="demo-link" href="https://drive.proton.me/urls/5ND49D487R#IxRa3Bd0Lm8L" target="_blank" rel="noopener noreferrer">
                <img class="demo-cover" src="assets/demo-packs/leo-la-licorne.png" alt="Couverture de Léo la licorne" />
                <span class="demo-link-copy">
                  <span>Léo la licorne</span>
                  <span class="demo-link-source">Télécharger sur Proton Drive ↗</span>
                </span>
              </a>
              <a class="demo-link" href="https://drive.proton.me/urls/H7ZTBC8S14#aj2WBn39jDRF" target="_blank" rel="noopener noreferrer">
                <img class="demo-cover" src="assets/demo-packs/toudou-cache-cache.png" alt="Couverture de Toudou mon doudou et Cache-Cache" />
                <span class="demo-link-copy">
                  <span>Toudou mon doudou + Cache-Cache</span>
                  <span class="demo-link-source">Télécharger sur Proton Drive ↗</span>
                </span>
              </a>
            </div>
            <ol class="demo-steps">
              <li>Télécharge le fichier ZIP du pack depuis Proton Drive.</li>
              <li>Lance Story Studio et clique sur <strong>Modifier un pack existant</strong>.</li>
              <li>Sélectionne le fichier <code>.zip</code> téléchargé.</li>
            </ol>
            <p class="demo-note">
              Ces packs sont distribués séparément du logiciel et leurs contenus ne
              sont pas couverts par la licence MIT de Story Studio.
            </p>
          </div>
        </div>
        <div class="hero-shot">
          <img src="assets/screenshots/graph-editor-overview-dark.png" alt="Vue générale de l'Éditeur graphe avec la liste des nœuds et l'Inspecteur" width="2554" height="1439" />
        </div>
      </section>

      <section id="features">
        <div class="container">
          <h2>Du premier import au pack prêt à jouer</h2>
          <p class="journey-intro">
            Story Studio rassemble tout le parcours dans une application locale :
            partir de tes propres fichiers ou d'un pack existant, préparer les
            médias, construire la navigation, tester le résultat et générer un
            pack prêt pour la Lunii. Le catalogue permet aussi de gérer ta
            collection et les transferts vers l'appareil.
          </p>

          <div class="journey">
            <article class="journey-step">
              <div class="journey-copy">
                <span class="journey-number">1</span>
                <h3>Démarrer un projet ou importer des histoires</h3>
                <p>
                  Crée selon tes envies, reprends un travail enregistré,
                  modifie un pack ZIP/7z existant ou pars d'un podcast ou de
                  YouTube. Des parcours guidés permettent aussi d'agréger
                  plusieurs packs ou d'analyser un pack communautaire.
                </p>
              </div>
              <figure class="journey-media">
                <img src="assets/screenshots/home-dark.png" alt="Accueil de Story Studio avec les trois éditeurs et les parcours guidés" loading="lazy" />
              </figure>
            </article>

            <article class="journey-step journey-step--flip">
              <div class="journey-copy">
                <span class="journey-number">2</span>
                <h3>Gérer ta collection et transférer tes packs sur la Lunii</h3>
                <p>
                  Ajoute tes dossiers sources et retrouve tes packs en vignettes
                  ou en liste. Recherche, filtre et organise ta collection
                  avec les favoris et les étiquettes, puis sauvegarde les données
                  de ton catalogue.
                </p>
              </div>
              <div class="journey-copy">
                <p>
                  Branche ta Lunii pour voir ses histoires, envoyer tes packs,
                  les rapatrier dans le catalogue et gérer la liste de l'appareil.
                  Suis les transferts et éjecte la Lunii une fois terminé.
                  Les titres et jaquettes officiels sont facultatifs et nécessitent
                  ton accord. Sauvegarde ta Lunii avant la première écriture.
                </p>
              </div>
              <figure class="journey-media journey-media--span2">
                <img src="assets/screenshots/catalogue-lunii-dark.png" alt="Catalogue de Story Studio avec une Lunii connectée et sa liste d'histoires" loading="lazy" />
              </figure>
            </article>

            <article class="journey-step">
              <div class="journey-copy">
                <span class="journey-number">3</span>
                <h3>Préparer les fichiers audio</h3>
                <p>
                  Importe ou enregistre un son, puis ajuste-le avant de
                  l'utiliser dans une histoire. Un enregistrement long peut être
                  découpé en extraits réutilisables ; plusieurs fichiers peuvent
                  aussi être réordonnés et assemblés en une seule piste sans
                  modifier les originaux.
                </p>
              </div>
              <figure class="journey-media">
                <img
                  src="assets/screenshots/audio-editor-dark.png"
                  alt="Éditeur audio de Story Studio"
                  loading="lazy"
                />
              </figure>
              <div class="media-pair">
                <figure>
                  <img
                    src="assets/screenshots/Audio-decoupe-light.png"
                    alt="Découpe d'un enregistrement audio en plusieurs extraits"
                    loading="lazy"
                  />
                  <figcaption>Découper un enregistrement long</figcaption>
                </figure>
                <figure>
                  <img
                    src="assets/screenshots/Audio-assemble-light.png"
                    alt="Assemblage de plusieurs fichiers audio"
                    loading="lazy"
                  />
                  <figcaption>Réordonner et assembler plusieurs pistes</figcaption>
                </figure>
              </div>
            </article>

            <article class="journey-rows">
              <div class="journey-row journey-row--text">
                <span class="journey-number">4</span>
                <div class="journey-copy">
                  <h3>Générer les voix et les images</h3>
                  <p>
                    Piper fournit une synthèse vocale locale prête à l'emploi ;
                    XTTS peut être utilisé pour des voix personnalisées. Pour les
                    illustrations, Story Studio pilote les workflows ComfyUI
                    configurés dans l'application.
                  </p>
                </div>
                <div class="journey-copy">
                  <h3>Modifier et adapter les images</h3>
                  <p>
                    Les images peuvent ensuite être recadrées, redimensionnées et
                    ajustées au format 320×240 de la boîte à histoires.
                  </p>
                </div>
              </div>
              <div class="media-trio">
                <figure>
                  <img
                    src="assets/screenshots/voice-generation-dark.png"
                    alt="Génération locale d'une voix avec Piper"
                    loading="lazy"
                  />
                  <figcaption>Générer une voix avec Piper ou XTTS</figcaption>
                </figure>
                <figure>
                  <img
                    src="assets/screenshots/comfyui-generation-dark.png"
                    alt="Génération d'une image avec un workflow ComfyUI"
                    loading="lazy"
                  />
                  <figcaption>Créer une illustration avec ComfyUI</figcaption>
                </figure>
                <figure>
                  <img
                    src="assets/screenshots/image-editor-dark.png"
                    alt="Outils de recadrage et d'ajustement d'une image"
                    loading="lazy"
                  />
                  <figcaption>Recadrer et ajuster une image</figcaption>
                </figure>
              </div>
            </article>

            <article class="journey-rows">
              <div class="journey-row">
                <div class="journey-copy">
                  <span class="journey-number">5</span>
                  <h3>Construire et tester la navigation</h3>
                  <p>
                    L'Éditeur par menus organise simplement les Dossiers et les
                    Histoires sous forme d'arborescence. Le panneau Réglages et le
                    Diagramme permettent ensuite de relire les retours et les
                    enchaînements produits.
                  </p>
                </div>
                <figure class="journey-media">
                  <img
                    src="assets/screenshots/workspace-dark.png"
                    alt="Éditeur par menus avec l'Arbre, les Réglages et le Diagramme"
                    loading="lazy"
                  />
                </figure>
              </div>
              <div class="journey-row journey-row--flip">
                <div class="journey-copy">
                  <p>
                    <a href="docs/editeur-graphe/">L'Éditeur graphe</a> donne directement accès aux Écrans, aux
                    Listes de choix et à leurs raccords. Il permet de construire
                    des histoires à choix multiples, des quiz, des tirages
                    aléatoires et des parcours croisés.
                  </p>
                  <p>
                    Les deux éditeurs partagent la Bibliothèque médias, les outils audio, la file de
                    rendu et le même Simulateur flottant. Tu peux parcourir
                    l'histoire comme sur la boîte avant de générer le ZIP.
                  </p>
                </div>
                <figure class="journey-media">
                  <img
                    src="assets/screenshots/diagram-simulator-dark.png"
                    alt="Diagramme du pack avec le Simulateur flottant"
                    loading="lazy"
                  />
                </figure>
              </div>
            </article>

            <article class="journey-rows">
              <div class="journey-row">
                <div class="journey-copy">
                  <span class="journey-number">6</span>
                  <h3>Vérifier les réglages puis générer le ZIP</h3>
                  <p>
                    Contrôle dans la Fiche du pack les métadonnées, la Vignette
                    catalogue et le traitement audio avant la génération du ZIP. Story Studio
                    vérifie la structure, l'identité et les médias, puis relit le
                    ZIP produit avant de terminer.
                  </p>
                </div>
                <figure class="journey-media">
                  <img
                    src="assets/screenshots/pack-metadata-dark.png"
                    alt="Fiche du pack avec la Vignette catalogue, l'UUID et le nom du ZIP"
                    loading="lazy"
                  />
                </figure>
              </div>
              <div class="journey-row journey-row--flip">
                <div class="journey-copy">
                  <p>
                    Le parcours de vérification peut aussi analyser un pack
                    communautaire existant : format, images, niveau sonore,
                    silences et navigation sont réunis dans un rapport lisible.
                  </p>
                </div>
                <figure class="journey-media">
                  <img
                    src="assets/screenshots/pack-checker-dark.png"
                    alt="Rapport de vérification d'un pack communautaire"
                    loading="lazy"
                  />
                </figure>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="origin">
        <div class="container origin">
          <h2>Pourquoi Story Studio ?</h2>
          <p>
            Je cherchais un outil simple pour créer des histoires audio pour
            mon enfant. En tant qu'ancien monteur vidéo, je ne retrouvais pas
            dans les outils existants ce qui me semblait essentiel : une
            interface visuelle, directe et fluide, permettant de construire
            une narration sans friction, sans ligne de commande ni structures
            de dossiers complexes.
          </p>
          <p>
            Story Studio est né de ce besoin : rassembler l'import, les images,
            l'audio, la navigation, la simulation, le catalogue et les transferts dans un même
            espace clair, local et compréhensible.
          </p>
        </div>
      </section>

      <section id="install">
        <div class="container">
          <h2>Installer Story Studio</h2>
          <div class="steps">
            <div class="step">
              <h3>Choisis ta plateforme</h3>
              <p>
                Le bouton en haut de la page propose le paquet recommandé pour ton
                système. La page GitHub Releases donne accès à tous les formats.
              </p>
            </div>
            <div class="step">
              <h3>Installe le paquet</h3>
              <p>
                Sous Windows, lance l'EXE ou utilise le MSI. Sous Linux,
                exécute l'AppImage ou installe le DEB/RPM. Sur Mac Apple
                Silicon, ouvre le DMG et glisse l'app dans Applications.
              </p>
            </div>
            <div class="step">
              <h3>Lance Story Studio</h3>
              <p>
                Le build macOS n'est pas notarisé : au premier lancement,
                fais un Contrôle-clic sur l'app puis choisis
                <em>Ouvrir</em>, sans désactiver Gatekeeper globalement.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site">
      <div class="container">
        <div class="disclaimer">
          Story Studio est un outil communautaire gratuit et open source.
          <strong>Il n'est pas affilié, soutenu ou sponsorisé par Lunii.</strong>
        </div>
        <div class="disclaimer">
          <strong>Story Studio est conçu et développé avec l'aide d'outils d'intelligence artificielle. Les choix de conception, la direction du projet et la validation finale reviennent à un humain.</strong>
        </div>
        <div class="links">
          <a href="docs/">Documentation</a>
          <a href="https://discord.gg/jeC6Qk4NS" target="_blank" rel="noopener noreferrer">Discord</a>
          <a href="https://github.com/Hugs11/story-studio">Code source (GitHub)</a>
          <a href="https://github.com/Hugs11/story-studio/issues">Signaler un bug</a>
          <a href="https://github.com/Hugs11/story-studio/blob/main/CHANGELOG.md">Changelog</a>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var REPO = "Hugs11/story-studio";
        var API = "https://api.github.com/repos/" + REPO + "/releases/latest";
        var RELEASES_URL = "https://github.com/" + REPO + "/releases/latest";

        var btn = document.getElementById("download-btn");
        var label = document.getElementById("download-label");
        var meta = document.getElementById("download-meta");
        var versionText = document.getElementById("version-text");

        function formatSize(bytes) {
          if (!bytes && bytes !== 0) return "";
          var mb = bytes / (1024 * 1024);
          return mb >= 1 ? mb.toFixed(1) + " Mo" : (bytes / 1024).toFixed(0) + " Ko";
        }

        function detectPlatform() {
          var platform = (navigator.userAgentData && navigator.userAgentData.platform) ||
            navigator.platform || navigator.userAgent || "";
          if (/Mac/i.test(platform)) return "macos";
          if (/Linux|X11/i.test(platform)) return "linux";
          if (/Win/i.test(platform)) return "windows";
          return "other";
        }

        function platformDetails(platform) {
          if (platform === "macos") {
            return {
              label: "Télécharger pour macOS Apple Silicon",
              meta: "macOS 11 ou plus récent · DMG ARM64",
              pattern: /\.dmg$/i
            };
          }
          if (platform === "linux") {
            return {
              label: "Télécharger pour Linux",
              meta: "Linux x86_64 · AppImage",
              pattern: /\.AppImage$/i
            };
          }
          if (platform === "windows") {
            return {
              label: "Télécharger pour Windows",
              meta: "Windows 10 ou plus récent · EXE x64",
              pattern: /\.exe$/i
            };
          }
          return null;
        }

        function pickAsset(assets, details) {
          if (!assets || !assets.length) return null;
          if (!details) return null;
          return assets.find(function (asset) {
            return details.pattern.test(asset.name) && !/\.sig$/i.test(asset.name);
          });
        }

        function setFallback(message) {
          versionText.textContent = message || "Story Studio 0.9.11 — Voir les téléchargements";
          label.textContent = "Voir les téléchargements";
          btn.setAttribute("href", RELEASES_URL);
          meta.textContent = "Ce bouton ouvre la page GitHub Releases.";
        }

        fetch(API, { headers: { Accept: "application/vnd.github+json" } })
          .then(function (res) {
            if (!res.ok) throw new Error("HTTP " + res.status);
            return res.json();
          })
          .then(function (release) {
            var version = (release.tag_name || release.name || "").replace(/^v/i, "");
            var versionLabel = version ? "Version " + version + (release.prerelease ? " — Bêta" : "") : "Voir les versions disponibles";
            versionText.textContent = versionLabel;

            var details = platformDetails(detectPlatform());
            var asset = pickAsset(release.assets || [], details);
            if (asset && asset.browser_download_url) {
              btn.setAttribute("href", asset.browser_download_url);
              label.textContent = details.label;
              var size = formatSize(asset.size);
              meta.textContent =
                details.meta + " · " +
                asset.name +
                (size ? " (" + size + ")" : "");
            } else {
              setFallback(versionLabel);
            }
          })
          .catch(function () {
            setFallback();
          });
      })();
    </script>
  </body>
</html>
